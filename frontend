            const name = document.getElementById('regName').value;
            const phone = document.getElementById('regPhone').value;
            const address = document.getElementById('regAddress').value;
            const pincode = document.getElementById('regPincode').value;
            const city = document.getElementById('regCity').value;

            currentUser = { name, phone, address, pincode, city };
            localStorage.setItem('bachat_user', JSON.stringify(currentUser));

            updateUserUI();
            closeAuthModal();
            showToast(`Welcome ${name}! Location set to ${pincode}, ${city}`);
            
            // Refresh current product calculations to reflect address
            if (activeProduct) renderProductDetails(activeProduct);
        }

        function updateUserUI() {
            if (currentUser) {
                document.getElementById('navUserName').innerText = currentUser.name.split(' ')[0];
                document.getElementById('navUserAddress').innerText = `${currentUser.pincode} (${currentUser.city})`;
            }
        }

        // SEARCH ENGINE LOGIC
        function handleSearchKey(e) {
            const query = e.target.value.toLowerCase().trim();
            const suggestionsBox = document.getElementById('searchSuggestions');

            if (e.key === 'Enter') {
                performSearch();
                return;
            }

            if (query.length === 0) {
                suggestionsBox.classList.add('hidden');
                return;
            }

            const matches = PRODUCTS_DB.filter(p => p.name.toLowerCase().includes(query) || p.category.toLowerCase().includes(query));

            if (matches.length > 0) {
                suggestionsBox.innerHTML = matches.map(p => `
                    <div onclick="selectProduct('${p.id}')" class="p-3 hover:bg-slate-100 cursor-pointer flex items-center justify-between border-b border-slate-100 last:border-0 transition">
                        <div class="flex items-center space-x-3">
                            <img src="${p.img}" class="w-8 h-8 object-contain">
                            <div>
                                <p class="font-bold text-sm text-slate-800">${p.name}</p>
                                <p class="text-xs text-slate-500">${p.unit} • ${p.category}</p>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-brandGreen bg-emerald-50 px-2 py-1 rounded">Compare</span>
                    </div>
                `).join('');
                suggestionsBox.classList.remove('hidden');
            } else {
                suggestionsBox.innerHTML = `<div class="p-4 text-center text-slate-500 text-sm font-semibold">No exact item found. Try "Milk", "Maggi", or "Oil"</div>`;
                suggestionsBox.classList.remove('hidden');
            }
        }

        function quickSearch(term) {
            document.getElementById('searchInput').value = term;
            performSearch();
        }

        function performSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            document.getElementById('searchSuggestions').classList.add('hidden');

            const matched = PRODUCTS_DB.find(p => p.name.toLowerCase().includes(query));
            if (matched) {
                selectProduct(matched.id);
            } else if (query.length > 0) {
                showToast(`No exact match for "${query}". Showing Amul Milk comparison.`, 'warn');
                selectProduct('p1');
            }
        }

        function selectProduct(id) {
            document.getElementById('searchSuggestions').classList.add('hidden');
            const product = PRODUCTS_DB.find(p => p.id === id);
            if (!product) return;

            activeProduct = product;
            showSection('home');
            document.getElementById('popularSection').classList.add('hidden');
            document.getElementById('comparisonContainer').classList.remove('hidden');

            renderProductDetails(product);
        }

        // RENDER DETAILED PRODUCT COMPARISON ENGINE
        function renderProductDetails(product) {
            document.getElementById('detailTitle').innerText = product.name;
            document.getElementById('detailCategory').innerText = product.category;
            document.getElementById('detailUnit').innerText = product.unit;
            document.getElementById('detailImg').src = product.img;

            // Calculate Effective Costs across platforms
            let comparisonData = [];
            let cheapestItemPrice = Infinity;
            let cheapestItemApp = '';
            let highestItemPrice = 0;

            let lowestEffectiveCost = Infinity;
            let bestEffectiveApp = '';
            let bestEffectiveBreakdown = '';

            Object.keys(PLATFORM_CONFIG).forEach(platform => {
                const config = PLATFORM_CONFIG[platform];
                const platData = product.prices[platform];

                if (platData && platData.available) {
                    const price = platData.price;
                    if (price < cheapestItemPrice) {
                        cheapestItemPrice = price;
                        cheapestItemApp = platform;
                    }
                    if (price > highestItemPrice) highestItemPrice = price;

                    // Calculate Effective Total for 1 item
                    const delivery = price >= config.freeThreshold ? 0 : config.deliveryFee;
                    const totalCost = price + delivery + config.handlingFee;

                    if (totalCost < lowestEffectiveCost) {
                        lowestEffectiveCost = totalCost;
                        bestEffectiveApp = platform;
                        bestEffectiveBreakdown = `Item ₹${price} + ${delivery > 0 ? '₹'+delivery+' Delivery' : 'FREE Del.'} + ₹${config.handlingFee} Platform Fee`;
                    }

                    comparisonData.push({
                        platform,
                        price,
                        deliveryFee: delivery,
                        handlingFee: config.handlingFee,
                        freeThreshold: config.freeThreshold,
                        totalCost,
                        available: true,
                        url: platData.url
                    });
                } else {
                    comparisonData.push({
                        platform,
                        price: '-',
                        deliveryFee: config.deliveryFee,
                        handlingFee: config.handlingFee,
                        freeThreshold: config.freeThreshold,
                        totalCost: '-',
                        available: false,
                        url: '#'
                    });
                }
            });

            // Update Key Highlight Cards
            document.getElementById('cheapestAppName').innerText = cheapestItemApp;
            document.getElementById('cheapestPrice').innerText = `₹${cheapestItemPrice}`;
            document.getElementById('cheapestSave').innerText = `Saves ₹${(highestItemPrice - cheapestItemPrice).toFixed(1)} vs max`;

            document.getElementById('effectiveAppName').innerText = bestEffectiveApp;
            document.getElementById('effectivePrice').innerText = `₹${lowestEffectiveCost}`;
            document.getElementById('effectiveReason').innerText = bestEffectiveBreakdown;

            // Second Best Alternative
            const sortedByItem = [...comparisonData].filter(c => c.available).sort((a,b) => a.price - b.price);
            if (sortedByItem.length > 1) {
                document.getElementById('altAppName').innerText = sortedByItem[1].platform;
                document.getElementById('altPrice').innerText = `₹${sortedByItem[1].price}`;
            }

            // Render Platform Comparison Table
            const tableBody = document.getElementById('platformTableBody');
            tableBody.innerHTML = comparisonData.map(c => {
                const isCheapestItem = c.platform === cheapestItemApp;
                const isBestEffective = c.platform === bestEffectiveApp;

                return `
                    <tr class="hover:bg-slate-50/80 transition ${isBestEffective ? 'bg-amber-50/40 font-semibold' : ''}">
                        <td class="p-4 flex items-center space-x-3">
                            <img src="${PLATFORM_CONFIG[c.platform].logo}" class="w-8 h-8 rounded-lg object-cover border border-slate-200">
                            <div>
                                <span class="font-bold text-slate-800">${c.platform}</span>
                                ${isBestEffective ? '<span class="ml-2 text-[10px] bg-brandOrange text-white font-black px-2 py-0.5 rounded-full">Best Order</span>' : ''}
                                ${isCheapestItem ? '<span class="ml-2 text-[10px] bg-brandGreen text-white font-black px-2 py-0.5 rounded-full">Lowest Price</span>' : ''}
                            </div>
                        </td>
                        <td class="p-4 font-extrabold ${isCheapestItem ? 'text-brandGreen text-base' : 'text-slate-800'}">
                            ${c.available ? '₹' + c.price : '<span class="text-slate-400 font-normal">Out of stock</span>'}
                        </td>
                        <td class="p-4 text-slate-600">
                            ${c.available ? (c.deliveryFee === 0 ? '<span class="text-brandGreen font-bold">FREE</span>' : '₹' + c.deliveryFee) : '-'}
                        </td>
                        <td class="p-4 text-slate-600">
                            ${c.available ? (c.handlingFee === 0 ? '₹0' : '₹' + c.handlingFee) : '-'}
                        </td>
                        <td class="p-4 font-extrabold ${isBestEffective ? 'text-brandOrange text-base' : 'text-slate-900'}">
                            ${c.available ? '₹' + c.totalCost : '-'}
                        </td>
                        <td class="p-4 text-center">
                            ${c.available ? 
                                `<span class="text-xs bg-emerald-100 text-brandGreen font-bold px-2.5 py-1 rounded-full">Free del > ₹${c.freeThreshold}</span>` : 
                                `<span class="text-xs bg-slate-100 text-slate-500 font-bold px-2.5 py-1 rounded-full">Unavailable</span>`}
                        </td>
                        <td class="p-4 text-right">
                            ${c.available ? `
                                <a href="${c.url}" target="_blank" class="inline-flex items-center space-x-1 text-xs bg-slate-900 hover:bg-brandGreen text-white font-bold px-3 py-1.5 rounded-lg transition">
                                    <span>Buy on ${c.platform.split(' ')[0]}</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                            ` : '<span class="text-xs text-slate-400">N/A</span>'}
                        </td>
                    </tr>
                `;
            }).join('');

            // Smart Add-On Calculation for Free Delivery
            renderSmartAddonAdvisor(product, cheapestItemApp, cheapestItemPrice);

            // Value Per Unit Rendering
            renderUnitValueMetrics(product, cheapestItemPrice);

            // AI Smart Alternatives
            renderAIAlternatives(product);

            // Render Price History Chart
            renderPriceChart(product);
        }

        function renderSmartAddonAdvisor(product, topApp, topPrice) {
            const config = PLATFORM_CONFIG[topApp];
            const needed = config.freeThreshold - topPrice;

            const boxText = document.getElementById('smartAddonText');
            const addonList = document.getElementById('smartAddonList');

            if (needed <= 0) {
                boxText.innerHTML = `On <span class="font-bold text-slate-900">${topApp}</span>, your item already exceeds the ₹${config.freeThreshold} threshold. <span class="font-bold text-brandGreen">You get FREE Delivery automatically!</span>`;
                addonList.innerHTML = `<div class="text-xs text-slate-500 italic">No add-ons needed for free delivery.</div>`;
                return;
            }

            boxText.innerHTML = `
                On <span class="font-bold text-slate-900">${topApp}</span>, your item is ₹${topPrice}. You are <span class="font-bold text-brandOrange">₹${needed.toFixed(0)} short</span> of the ₹${config.freeThreshold} threshold for <span class="font-bold text-brandGreen">FREE Delivery</span>!
            `;

            // Pick suggested add-ons
            const suggestedProds = product.suggestedAddons.map(id => PRODUCTS_DB.find(p => p.id === id)).filter(Boolean);

            addonList.innerHTML = suggestedProds.map(addon => {
                const addPrice = addon.prices[topApp]?.price || 30;
                const newTotal = topPrice + addPrice;
                const isFreeNow = newTotal >= config.freeThreshold;

                return `
                    <div class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col justify-between shadow-xs">
                        <div>
                            <div class="flex items-center space-x-2">
                                <img src="${addon.img}" class="w-8 h-8 object-contain">
                                <span class="font-bold text-xs text-slate-800 line-clamp-1">${addon.name}</span>
                            </div>
                            <div class="mt-2 flex justify-between items-baseline">
                                <span class="text-sm font-black text-brandGreen">₹${addPrice}</span>
                                ${isFreeNow ? '<span class="text-[10px] text-emerald-700 font-extrabold bg-emerald-100 px-1.5 py-0.5 rounded">Unlocks Free Del!</span>' : ''}
                            </div>
                        </div>
                        <button onclick="addAddonToBasket('${addon.id}')" class="mt-2 w-full text-xs bg-slate-100 hover:bg-brandGreen hover:text-white font-bold py-1 rounded-lg transition text-slate-700">
                            + Add Add-on
                        </button>
                    </div>
                `;
            }).join('');
        }

        function renderUnitValueMetrics(product, lowestPrice) {
            document.getElementById('unitStandard').innerText = `${product.unitQtyVal} ${product.unitType} (${product.unit})`;
            const rate = (lowestPrice / product.unitQtyVal).toFixed(3);
            document.getElementById('unitRate').innerText = `₹${rate} / ${product.unitType}`;
        }

        function renderAIAlternatives(product) {
            const container = document.getElementById('aiAlternativesList');
            if (!product.alternatives || product.alternatives.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400">No alternatives mapped.</p>`;
                return;
            }

            container.innerHTML = product.alternatives.map(alt => `
                <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
                    <div>
                        <p class="font-bold text-xs text-slate-800">${alt.name}</p>
                        <p class="text-[10px] text-slate-500">Available on ${alt.platform}</p>
                    </div>
                    <span class="text-xs font-black text-brandGreen bg-emerald-100 px-2 py-0.5 rounded">₹${alt.price}</span>
                </div>
            `).join('');
        }

        function renderPriceChart(product) {
            const ctx = document.getElementById('priceHistoryChart').getContext('2d');
            if (priceChartInstance) {
                priceChartInstance.destroy();
            }

            const days = ['6 Days Ago', '5 Days Ago', '4 Days Ago', '3 Days Ago', '2 Days Ago', 'Yesterday', 'Today'];

            priceChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: days,
                    datasets: [{
                        label: 'Lowest Market Price (₹)',
                        data: product.priceHistory,
                        borderColor: '#007A37',
                        backgroundColor: 'rgba(0, 122, 55, 0.08)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#FF5722',
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { family: 'Calibri, sans-serif', size: 12 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Calibri, sans-serif', size: 11 } }
                        }
                    }
                }
            });
        }

        function renderPopularGrid() {
            const grid = document.getElementById('popularProductsGrid');
            grid.innerHTML = PRODUCTS_DB.map(p => {
                // Find lowest price
                const prices = Object.values(p.prices).map(v => v.price).filter(Number.isFinite);
                const minPrice = Math.min(...prices);

                return `
                    <div onclick="selectProduct('${p.id}')" class="bg-white p-4 rounded-2xl border border-slate-200 hover:border-brandGreen hover:shadow-lg transition cursor-pointer flex flex-col justify-between group">
                        <div>
                            <div class="relative bg-slate-50 p-4 rounded-xl mb-3 border border-slate-100 flex items-center justify-center h-36">
                                <img src="${p.img}" alt="${p.name}" class="h-28 object-contain group-hover:scale-105 transition">
                                <span class="absolute top-2 right-2 text-[10px] font-black bg-emerald-100 text-brandGreen px-2 py-0.5 rounded-full">Top Deal</span>
                            </div>
                            <span class="text-[10px] uppercase font-bold text-slate-400">${p.category}</span>
                            <h3 class="font-bold text-slate-900 text-sm line-clamp-2 mt-0.5">${p.name}</h3>
                            <p class="text-xs text-slate-500 mt-0.5">${p.unit}</p>
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] text-slate-400 block font-semibold">Starts at</span>
                                <span class="text-lg font-black text-brandGreen">₹${minPrice}</span>
                            </div>
                            <span class="text-xs bg-slate-900 group-hover:bg-brandGreen text-white font-bold px-3 py-1.5 rounded-lg transition">Compare →</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function addToBasketCurrent() {
            if (!activeProduct) return;
            const existing = userBasket.find(i => i.productId === activeProduct.id);
            if (existing) {
                existing.quantity += 1;
            } else {
                userBasket.push({ productId: activeProduct.id, quantity: 1 });
            }
            updateBasketCountBadge();
            showToast(`Added "${activeProduct.name}" to Bachat Basket`);
        }

        function addAddonToBasket(id) {
            const prod = PRODUCTS_DB.find(p => p.id === id);
            if (!prod) return;
            const existing = userBasket.find(i => i.productId === id);
            if (existing) {
                existing.quantity += 1;
            } else {
                userBasket.push({ productId: id, quantity: 1 });
            }
            updateBasketCountBadge();
            showToast(`Added "${prod.name}" to Bachat Basket`);
        }

        function updateBasketCountBadge() {
            const count = userBasket.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('basketCountBadge').innerText = count;
        }

        function clearBasket() {
            userBasket = [];
            updateBasketCountBadge();
            renderBasketOptimizer();
            showToast('Basket cleared');
        }

        function populateQuickBasketDropdown() {
            const select = document.getElementById('quickBasketSelect');
            select.innerHTML = PRODUCTS_DB.map(p => `
                <option value="${p.id}">${p.name} (${p.unit})</option>
            `).join('');
        }

        function addQuickBasketItem() {
            const id = document.getElementById('quickBasketSelect').value;
            addAddonToBasket(id);
            renderBasketOptimizer();
        }

        function changeQty(id, delta) {
            const idx = userBasket.findIndex(i => i.productId === id);
            if (idx > -1) {
                userBasket[idx].quantity += delta;
                if (userBasket[idx].quantity <= 0) {
                    userBasket.splice(idx, 1);
                }
            }
            updateBasketCountBadge();
            renderBasketOptimizer();
        }

        // BASKET MULTI-ITEM OPTIMIZATION CALCULATOR
        function renderBasketOptimizer() {
            const listContainer = document.getElementById('basketItemsList');
            document.getElementById('basketItemCount').innerText = `${userBasket.length} items`;

            if (userBasket.length === 0) {
                listContainer.innerHTML = `<div class="p-8 text-center text-slate-400 font-semibold text-sm">Your basket is empty. Add items from the search!</div>`;
                document.getElementById('singleAppTotal').innerText = '₹0';
                document.getElementById('splitAppTotal').innerText = '₹0';
                return;
            }

            // Render Basket List
            listContainer.innerHTML = userBasket.map(item => {
                const prod = PRODUCTS_DB.find(p => p.id === item.productId);
                return `
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <img src="${prod.img}" class="w-10 h-10 object-contain">
                            <div>
                                <h4 class="font-bold text-xs text-slate-800 line-clamp-1">${prod.name}</h4>
                                <p class="text-[10px] text-slate-500">${prod.unit}</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="changeQty('${prod.id}', -1)" class="w-6 h-6 bg-slate-200 hover:bg-slate-300 font-black rounded-lg text-xs flex items-center justify-center text-slate-700">-</button>
                            <span class="text-xs font-bold w-4 text-center text-slate-800">${item.quantity}</span>
                            <button onclick="changeQty('${prod.id}', 1)" class="w-6 h-6 bg-slate-200 hover:bg-slate-300 font-black rounded-lg text-xs flex items-center justify-center text-slate-700">+</button>
                        </div>
                    </div>
                `;
            }).join('');

            // Calculate Single-Store Order Totals
            let singleStoreResults = [];

            Object.keys(PLATFORM_CONFIG).forEach(platform => {
                const config = PLATFORM_CONFIG[platform];
                let subtotal = 0;
                let allAvailable = true;

                userBasket.forEach(item => {
                    const prod = PRODUCTS_DB.find(p => p.id === item.productId);
                    const pData = prod.prices[platform];
                    if (pData && pData.available) {
                        subtotal += pData.price * item.quantity;
                    } else {
                        allAvailable = false;
                    }
                });

                if (allAvailable) {
                    const delivery = subtotal >= config.freeThreshold ? 0 : config.deliveryFee;
                    const grandTotal = subtotal + delivery + config.handlingFee;

                    singleStoreResults.push({
                        platform,
                        subtotal,
                        delivery,
                        handling: config.handlingFee,
                        grandTotal
                    });
                }
            });

            singleStoreResults.sort((a,b) => a.grandTotal - b.grandTotal);

            if (singleStoreResults.length > 0) {
                const bestSingle = singleStoreResults[0];
                document.getElementById('singleAppTitle').innerText = `${bestSingle.platform} Order`;
                document.getElementById('singleAppTotal').innerText = `₹${bestSingle.grandTotal}`;
                document.getElementById('singleAppSubtotal').innerText = `₹${bestSingle.subtotal}`;
                document.getElementById('singleAppDelivery').innerText = bestSingle.delivery === 0 ? 'FREE' : `₹${bestSingle.delivery}`;
                document.getElementById('singleAppHandling').innerText = `₹${bestSingle.handling}`;
                document.getElementById('singleAppDeliveryNote').innerText = bestSingle.delivery === 0 ? 'Free Delivery Unlocked' : `Standard Delivery`;
            }

            // Calculate Split-Basket Optimization (Splitting items across cheapest platforms)
            let splitTotals = {};
            userBasket.forEach(item => {
                const prod = PRODUCTS_DB.find(p => p.id === item.productId);
                let cheapestPlat = '';
                let lowestItemPrice = Infinity;

                Object.keys(PLATFORM_CONFIG).forEach(plat => {
                    const pData = prod.prices[plat];
                    if (pData && pData.available && pData.price < lowestItemPrice) {
                        lowestItemPrice = pData.price;
                        cheapestPlat = plat;
                    }
                });

                if (!splitTotals[cheapestPlat]) {
                    splitTotals[cheapestPlat] = { items: [], subtotal: 0 };
                }
                splitTotals[cheapestPlat].items.push({ prod, qty: item.quantity, price: lowestItemPrice });
                splitTotals[cheapestPlat].subtotal += lowestItemPrice * item.quantity;
            });

            let splitGrandTotal = 0;
            const splitBreakdownEl = document.getElementById('splitAppBreakdown');
            let splitHTML = '';

            Object.keys(splitTotals).forEach(plat => {
                const group = splitTotals[plat];
                const config = PLATFORM_CONFIG[plat];
                const delivery = group.subtotal >= config.freeThreshold ? 0 : config.deliveryFee;
                const total = group.subtotal + delivery + config.handlingFee;
                splitGrandTotal += total;

                splitHTML += `
                    <div class="bg-white p-3 rounded-xl border border-orange-200 text-xs">
                        <div class="flex justify-between font-bold text-slate-800">
                            <span>Order from ${plat} (${group.items.length} items)</span>
                            <span class="text-brandOrange">₹${total}</span>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-1">
                            Items: ${group.items.map(i => i.prod.name.split(' ')[0]).join(', ')} • Delivery: ₹${delivery}
                        </div>
                    </div>
                `;
            });

            document.getElementById('splitAppTotal').innerText = `₹${splitGrandTotal}`;
            splitBreakdownEl.innerHTML = splitHTML;

            if (singleStoreResults.length > 0) {
                const diff = singleStoreResults[0].grandTotal - splitGrandTotal;
                document.getElementById('splitAppSavings').innerText = diff > 0 ? `Saves ₹${diff.toFixed(0)} extra by splitting!` : `Single store is equally cheap!`;
            }
        }

        function buyBasketSingle() {
            showToast('Redirecting to platform to purchase full basket...');
        }
    </script>
</body>
</html>
