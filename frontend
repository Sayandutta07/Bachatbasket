<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bachat Hub - Compare. Save. Saste Mein.</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for Price History Graphs -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandGreen: '#007A37',
                        brandOrange: '#FF5722',
                        brandYellow: '#FFB800',
                        brandDarkGreen: '#004d22',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: Calibri, Candara, 'Segoe UI', Segoe, Optima, Arial, sans-serif;
            background-color: #f4f6f8;
            color: #1f2937;
        }
        h1, h2, h3, h4, h5, h6, .brand-heading {
            font-family: 'Segoe UI', Calibri, 'Trebuchet MS', sans-serif;
            font-weight: 800;
            letter-spacing: -0.02em;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .badge-pulse {
            animation: pulse-glow 2s infinite;
        }
        @keyframes pulse-glow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.03); }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col antialiased">

    <!-- TOP NAVIGATION BAR -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- BRAND LOGO AREA -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="showSection('home')">
                    <!-- Custom SVG Logo reflecting Bachat Hub identity -->
                    <div class="relative flex items-center">
                        <svg class="h-12 w-auto" viewBox="0 0 420 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <!-- Shopping Cart Icon -->
                            <g transform="translate(10, 15)">
                                <path d="M10 20 L25 20 L45 75 L110 75 L125 35 L32 35" stroke="#FF5722" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                <path d="M40 35 L120 35 L108 70 L47 70 Z" fill="#FF8A65" opacity="0.3"/>
                                <!-- Rupee symbol inside cart -->
                                <text x="65" y="60" font-family="Arial, sans-serif" font-weight="900" font-size="28" fill="#FF5722" text-anchor="middle">₹</text>
                                <!-- Cart wheels -->
                                <circle cx="52" cy="85" r="7" fill="#1E293B"/>
                                <circle cx="100" cy="85" r="7" fill="#1E293B"/>
                                <circle cx="52" cy="85" r="3" fill="#FFF"/>
                                <circle cx="100" cy="85" r="3" fill="#FFF"/>
                            </g>
                            <!-- Search Glass over Logo -->
                            <g transform="translate(90, 10)">
                                <circle cx="30" cy="30" r="18" stroke="#1E293B" stroke-width="5" fill="none"/>
                                <line x1="43" y1="43" x2="58" y2="58" stroke="#1E293B" stroke-width="6" stroke-linecap="round"/>
                                <text x="30" y="38" font-family="Arial, sans-serif" font-weight="bold" font-size="20" fill="#007A37" text-anchor="middle">₹</text>
                            </g>
                            <!-- Swoosh Arcs -->
                            <path d="M 120 20 Q 260 0 380 30" stroke="#FF5722" stroke-width="4" fill="none" stroke-linecap="round"/>
                            <path d="M 110 85 Q 250 110 370 80" stroke="#007A37" stroke-width="4" fill="none" stroke-linecap="round"/>
                            <!-- Text Bachat Hub -->
                            <text x="145" y="62" font-family="'Segoe UI', Arial, sans-serif" font-weight="900" font-style="italic" font-size="44" fill="#007A37">Bachat</text>
                            <text x="290" y="62" font-family="'Segoe UI', Arial, sans-serif" font-weight="900" font-style="italic" font-size="44" fill="#FF5722">Hub</text>
                            <!-- Tagline -->
                            <text x="150" y="85" font-family="Calibri, Arial, sans-serif" font-weight="800" font-size="16" fill="#007A37">Compare.</text>
                            <text x="215" y="85" font-family="Calibri, Arial, sans-serif" font-weight="800" font-size="16" fill="#FF5722">Save.</text>
                            <text x="255" y="85" font-family="Calibri, Arial, sans-serif" font-weight="800" font-size="16" fill="#007A37">Saste Mein.</text>
                        </svg>
                    </div>
                </div>

                <!-- LOCATION & ADDRESS SELECTOR -->
                <div id="locationBadge" onclick="openAuthModal()" class="hidden md:flex items-center space-x-2 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-3 py-1.5 rounded-full cursor-pointer transition">
                    <i class="fa-solid fa-location-dot text-brandGreen"></i>
                    <div class="text-xs">
                        <p class="text-slate-500 font-medium leading-none">Delivering to</p>
                        <p id="navUserAddress" class="text-slate-800 font-bold leading-tight truncate max-w-[180px]">Set Location (Pincode)</p>
                    </div>
                    <i class="fa-solid fa-chevron-down text-slate-400 text-xs pl-1"></i>
                </div>

                <!-- RIGHT NAV ACTIONS -->
                <div class="flex items-center space-x-3">
                    <!-- BASKET OPTIMIZER BTN -->
                    <button onclick="showSection('basket')" class="relative flex items-center space-x-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2 rounded-xl transition shadow-sm">
                        <i class="fa-solid fa-basket-shopping text-brandYellow"></i>
                        <span class="hidden sm:inline">My Bachat Basket</span>
                        <span id="basketCountBadge" class="bg-brandOrange text-white text-xs font-black px-2 py-0.5 rounded-full">0</span>
                    </button>

                    <!-- USER ACCOUNT BTN -->
                    <button id="userAuthBtn" onclick="openAuthModal()" class="flex items-center space-x-2 border border-slate-300 hover:border-brandGreen text-slate-700 font-bold px-3.5 py-2 rounded-xl transition bg-white">
                        <i class="fa-solid fa-circle-user text-brandGreen text-lg"></i>
                        <span id="navUserName" class="hidden md:inline">Login / Register</span>
                    </button>
                </div>

            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- SEARCH HERO SECTION -->
        <section id="heroSearchSection" class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-green-900 rounded-3xl p-6 sm:p-10 text-white shadow-xl mb-8 relative overflow-hidden">
            <!-- Background Accent Graphic -->
            <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
                <i class="fa-solid fa-cart-shopping text-[240px]"></i>
            </div>

            <div class="relative z-10 max-w-3xl">
                <div class="inline-flex items-center space-x-2 bg-emerald-900/60 border border-emerald-500/40 px-3 py-1 rounded-full text-xs font-semibold text-emerald-200 mb-4">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>Live Real-Time Quick Commerce Price Comparison</span>
                </div>
                <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-3">
                    Don't just find the cheapest item.<br>
                    <span class="text-brandYellow">Find the cheapest way to buy it.</span>
                </h1>
                <p class="text-emerald-100 text-base sm:text-lg mb-6 leading-relaxed">
                    Compare total effective costs (Prices + Delivery Fees + Platform Charges - Discounts) across Blinkit, Zepto, BigBasket, Flipkart Minutes & Instamart.
                </p>

                <!-- SEARCH BAR FORM -->
                <div class="relative max-w-2xl">
                    <div class="flex items-center bg-white rounded-2xl shadow-lg p-2 border-2 border-emerald-400 focus-within:ring-4 focus-within:ring-emerald-300 transition">
                        <i class="fa-solid fa-magnifying-glass text-slate-400 text-xl pl-3 pr-2"></i>
                        <input type="text" id="searchInput" onkeyup="handleSearchKey(event)" placeholder="Search groceries e.g., Amul Milk 1L, Maggi, Fortune Oil, Eggs..." 
                               class="w-full text-slate-800 font-semibold placeholder-slate-400 focus:outline-none text-base sm:text-lg py-1 px-1">
                        <button onclick="performSearch()" class="bg-brandOrange hover:bg-orange-600 text-white font-bold px-6 py-3 rounded-xl transition flex items-center space-x-2 shadow-md">
                            <span>Compare</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>

                    <!-- SEARCH SUGGESTIONS DROPDOWN -->
                    <div id="searchSuggestions" class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 z-50 max-h-72 overflow-y-auto text-slate-800 custom-scrollbar">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- QUICK CATEGORY CHIPS -->
                <div class="mt-6 flex flex-wrap items-center gap-2 text-xs sm:text-sm">
                    <span class="text-emerald-200 font-semibold">Popular Searches:</span>
                    <button onclick="quickSearch('Amul Taaza Milk 1L')" class="bg-emerald-800/80 hover:bg-emerald-600 text-emerald-100 px-3 py-1 rounded-lg border border-emerald-600/40 transition">🥛 Amul Milk 1L</button>
                    <button onclick="quickSearch('Maggi 2-Minute Masala')" class="bg-emerald-800/80 hover:bg-emerald-600 text-emerald-100 px-3 py-1 rounded-lg border border-emerald-600/40 transition">🍜 Maggi Noodles</button>
                    <button onclick="quickSearch('Coca-Cola 750ml')" class="bg-emerald-800/80 hover:bg-emerald-600 text-emerald-100 px-3 py-1 rounded-lg border border-emerald-600/40 transition">🥤 Coca-Cola 750ml</button>
                    <button onclick="quickSearch('Fortune Sunlite Oil')" class="bg-emerald-800/80 hover:bg-emerald-600 text-emerald-100 px-3 py-1 rounded-lg border border-emerald-600/40 transition">🌻 Fortune Oil 1L</button>
                    <button onclick="quickSearch('Fresh Eggs')" class="bg-emerald-800/80 hover:bg-emerald-600 text-emerald-100 px-3 py-1 rounded-lg border border-emerald-600/40 transition">🥚 Eggs Pack of 6</button>
                </div>
            </div>
        </section>

        <!-- VIEW 1: HOME / SEARCH RESULTS -->
        <div id="homeSection" class="space-y-8">
            
            <!-- INITIAL DASHBOARD WELCOME / POPULAR ITEMS GRID -->
            <div id="popularSection">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Trending Everyday Essentials</h2>
                        <p class="text-slate-500 text-sm">Compare live prices across all quick commerce apps in your city</p>
                    </div>
                    <span class="text-xs bg-emerald-100 text-brandGreen font-bold px-3 py-1 rounded-full">Updated 5 mins ago</span>
                </div>

                <div id="popularProductsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
                    <!-- Populated via JavaScript -->
                </div>
            </div>

            <!-- PRODUCT COMPARISON DETAIL DASHBOARD (TRIGGERED ON SEARCH OR ITEM CLICK) -->
            <div id="comparisonContainer" class="hidden space-y-6">
                <!-- Search Result Header -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div class="flex items-start space-x-4">
                        <img id="detailImg" src="" alt="Product" class="w-20 h-20 object-contain bg-slate-50 p-2 rounded-xl border border-slate-200">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span id="detailCategory" class="text-xs font-bold uppercase bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Category</span>
                                <span id="detailUnit" class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Unit</span>
                            </div>
                            <h2 id="detailTitle" class="text-2xl font-bold text-slate-900 mt-1">Product Title</h2>
                            <p id="detailSubtitle" class="text-slate-500 text-sm">Normalized product mapping across 5 platforms</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center space-x-3 w-full md:w-auto">
                        <button id="addBasketBtn" onclick="addToBasketCurrent()" class="flex-1 md:flex-none bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-2.5 rounded-xl transition flex items-center justify-center space-x-2 shadow">
                            <i class="fa-solid fa-cart-plus"></i>
                            <span>Add to Bachat Basket</span>
                        </button>
                    </div>
                </div>

                <!-- KEY DECISION HIGHLIGHT CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <!-- CHEAPEST ITEM -->
                    <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 border-2 border-brandGreen p-5 rounded-2xl shadow-sm relative overflow-hidden">
                        <div class="absolute -right-4 -bottom-4 opacity-10 text-brandGreen">
                            <i class="fa-solid fa-trophy text-8xl"></i>
                        </div>
                        <div class="flex items-center space-x-2 text-brandGreen font-extrabold text-xs tracking-wider uppercase mb-2">
                            <i class="fa-solid fa-award text-sm"></i>
                            <span>Cheapest Base Item</span>
                        </div>
                        <div id="cheapestAppName" class="text-xl font-bold text-slate-800">BigBasket</div>
                        <div class="flex items-baseline space-x-2 mt-1">
                            <span id="cheapestPrice" class="text-3xl font-black text-brandGreen">₹66</span>
                            <span id="cheapestSave" class="text-xs text-emerald-800 font-bold bg-emerald-200/80 px-2 py-0.5 rounded">Saves ₹6 vs highest</span>
                        </div>
                        <p class="text-xs text-slate-600 mt-2">Item-only comparison excluding delivery charges.</p>
                    </div>

                    <!-- BEST OVERALL VALUE ORDER (SMART COST ENGINE) -->
                    <div class="bg-gradient-to-br from-amber-50 to-orange-100 border-2 border-brandOrange p-5 rounded-2xl shadow-sm relative overflow-hidden">
                        <div class="absolute -right-4 -bottom-4 opacity-10 text-brandOrange">
                            <i class="fa-solid fa-calculator text-8xl"></i>
                        </div>
                        <div class="flex items-center space-x-2 text-brandOrange font-extrabold text-xs tracking-wider uppercase mb-2">
                            <i class="fa-solid fa-shield-halved text-sm"></i>
                            <span>Best Effective Single Order</span>
                        </div>
                        <div id="effectiveAppName" class="text-xl font-bold text-slate-800">Blinkit</div>
                        <div class="flex items-baseline space-x-2 mt-1">
                            <span id="effectivePrice" class="text-3xl font-black text-brandOrange">₹68</span>
                            <span class="text-xs text-orange-800 font-bold bg-orange-200/80 px-2 py-0.5 rounded">Final Total Payable</span>
                        </div>
                        <p id="effectiveReason" class="text-xs text-slate-600 mt-2">Item ₹68 + ₹0 Delivery = ₹68 Total</p>
                    </div>

                    <!-- SECOND BEST ALTERNATIVE -->
                    <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
                        <div class="flex items-center space-x-2 text-slate-500 font-bold text-xs tracking-wider uppercase mb-2">
                            <i class="fa-solid fa-arrows-rotate text-sm text-blue-600"></i>
                            <span>Next Best Available</span>
                        </div>
                        <div id="altAppName" class="text-xl font-bold text-slate-800">Zepto</div>
                        <div class="flex items-baseline space-x-2 mt-1">
                            <span id="altPrice" class="text-2xl font-extrabold text-slate-800">₹70</span>
                            <span class="text-xs text-slate-500">In stock now</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-2">Fastest delivery alternative if top option is busy.</p>
                    </div>
                </div>

                <!-- DETAILED PLATFORM COMPARISON TABLE -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 bg-slate-50">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900">Live Platform Price Comparison</h3>
                            <p class="text-xs text-slate-500">Calculates minimum order thresholds & extra handling charges</p>
                        </div>
                        <span class="text-xs bg-slate-200 text-slate-700 font-bold px-3 py-1 rounded-lg">5 Platforms Scanned</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-600 text-xs uppercase font-bold border-b border-slate-200">
                                    <th class="p-4">Platform App</th>
                                    <th class="p-4">Item Price</th>
                                    <th class="p-4">Delivery Fee</th>
                                    <th class="p-4">Handling/Platform Fee</th>
                                    <th class="p-4">Effective Order Total</th>
                                    <th class="p-4 text-center">Status & Free Delivery</th>
                                    <th class="p-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="platformTableBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Dynamic Rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- FREE DELIVERY OPTIMIZER & SMART ADD-ON RECOMMENDATION -->
                <div id="smartAddonBox" class="bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-emerald-500/10 border-2 border-dashed border-amber-400 p-6 rounded-2xl shadow-sm">
                    <div class="flex items-start space-x-4">
                        <div class="bg-amber-500 text-white p-3 rounded-2xl text-xl font-bold shadow-sm">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </div>
                        <div class="flex-grow">
                            <div class="flex items-center space-x-2">
                                <h3 class="text-lg font-bold text-slate-900">Free Delivery Smart Optimizer</h3>
                                <span class="bg-amber-100 text-amber-800 text-xs font-bold px-2 py-0.5 rounded-full">Save Delivery Charges</span>
                            </div>
                            <p id="smartAddonText" class="text-sm text-slate-700 mt-1">
                                On <span class="font-bold text-slate-900">Blinkit</span>, your cart is ₹68. Add <span class="font-bold text-brandOrange">₹32 more</span> to reach the ₹100 threshold and unlock <span class="font-bold text-brandGreen">FREE Delivery</span>!
                            </p>

                            <!-- RECOMMENDED ADD-ON CARDS -->
                            <div class="mt-4">
                                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Suggested Low-Cost Add-ons to Unlock Free Shipping:</span>
                                <div id="smartAddonList" class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-2">
                                    <!-- Populated JS -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PRICE HISTORY CHART & VALUE PER UNIT METRICS -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <!-- CHART: PRICE HISTORY -->
                    <div class="lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h3 class="text-base font-bold text-slate-900">7-Day Price History Trends</h3>
                                <p class="text-xs text-slate-500">Track price fluctuations to know if you should buy now or wait</p>
                            </div>
                            <div class="text-right">
                                <span id="priceAdviceBadge" class="text-xs font-extrabold bg-emerald-100 text-brandGreen px-2.5 py-1 rounded-full">Great Time to Buy</span>
                            </div>
                        </div>
                        <div class="h-64 relative">
                            <canvas id="priceHistoryChart"></canvas>
                        </div>
                    </div>

                    <!-- VALUE METRICS & AI ALTERNATIVES -->
                    <div class="space-y-6">
                        <!-- PRICE PER UNIT CARD -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                            <div class="flex items-center space-x-2 text-slate-700 font-bold text-sm mb-3">
                                <i class="fa-solid fa-scale-balanced text-brandGreen"></i>
                                <span>Unit Value Calculation</span>
                            </div>
                            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2">
                                <div class="flex justify-between text-xs text-slate-600">
                                    <span>Quantity Standardized:</span>
                                    <span id="unitStandard" class="font-bold text-slate-800">1000 ml / 1 L</span>
                                </div>
                                <div class="flex justify-between text-xs text-slate-600">
                                    <span>Lowest Rate per ml/g:</span>
                                    <span id="unitRate" class="font-bold text-brandGreen">₹0.066 / ml</span>
                                </div>
                                <div class="flex justify-between text-xs text-slate-600 border-t border-slate-200 pt-2">
                                    <span>Bulk Value Score:</span>
                                    <span class="font-bold text-emerald-700">9.4 / 10 (High Value)</span>
                                </div>
                            </div>
                        </div>

                        <!-- AI SMART ALTERNATIVES CARD -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center space-x-2 text-slate-700 font-bold text-sm">
                                    <i class="fa-solid fa-brain text-brandOrange"></i>
                                    <span>AI Cheaper Alternatives</span>
                                </div>
                                <span class="text-[10px] bg-orange-100 text-orange-700 font-bold px-2 py-0.5 rounded">Smart Recommendation</span>
                            </div>
                            <div id="aiAlternativesList" class="space-y-2">
                                <!-- Dynamic Alternatives -->
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- VIEW 2: MULTI-ITEM BASKET OPTIMIZER -->
        <div id="basketSection" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <div class="flex items-center space-x-2">
                            <h2 class="text-2xl font-bold text-slate-900">Bachat Basket Optimizer</h2>
                            <span class="bg-emerald-100 text-brandGreen font-bold text-xs px-2.5 py-0.5 rounded-full">Multi-Item Engine</span>
                        </div>
                        <p class="text-slate-500 text-sm">We calculate whether buying all items together or splitting across 2 apps saves you maximum money!</p>
                    </div>
                    <button onclick="clearBasket()" class="text-xs text-red-600 hover:text-red-800 font-bold border border-red-200 hover:bg-red-50 px-3 py-1.5 rounded-lg transition">
                        <i class="fa-solid fa-trash-can mr-1"></i> Clear Basket
                    </button>
                </div>
            </div>

            <!-- BASKET CONTENT & OPTIMIZATION RESULTS -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- LEFT: CURRENT BASKET ITEMS (4 COLS) -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                        <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center justify-between">
                            <span>Your Grocery Basket Items</span>
